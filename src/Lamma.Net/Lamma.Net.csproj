<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LammaNet</RootNamespace>
    <AssemblyName>Lamma.Net</AssemblyName>
    <Description>Pure C# in-process inference engine for GGUF language models (llama.cpp-compatible), with quantized SIMD kernels, paged KV cache with prefix caching, continuous batching and multimodal (vision/audio) support.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lamma.Net.Tests" />
    <InternalsVisibleTo Include="Lamma.Net.Extensions.AI" />
    <InternalsVisibleTo Include="lamma" />
    <InternalsVisibleTo Include="Lamma.Net.Gpu" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

</Project>
